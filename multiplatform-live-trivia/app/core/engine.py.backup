"""Trivia Game Engine & State Machine."""
from __future__ import annotations

import asyncio
import logging
import time
from typing import Callable, List, Optional, Set

from app.core.leaderboard import LeaderboardManager
from app.core.matcher import match_answer
from app.models import (
    ChatMessage,
    GameCommand,
    GameCommandType,
    GameSnapshot,
    GameState,
    Question,
)

logger = logging.getLogger(__name__)


class TriviaEngine:
    def __init__(
        self,
        questions: List[Question],
        chat_queue: asyncio.Queue,
        question_duration_sec: float = 15.0,
        result_duration_sec: float = 5.0,
        transition_duration_sec: float = 3.0,
        snapshot_callback: Optional[Callable[[GameSnapshot], None]] = None,
    ) -> None:
        self.questions = questions
        self.chat_queue = chat_queue
        self.question_duration_sec = question_duration_sec
        self.result_duration_sec = result_duration_sec
        self.transition_duration_sec = transition_duration_sec
        self.snapshot_callback = snapshot_callback

        self.state = GameState.IDLE
        self.current_question_index = 0
        self.leaderboard_mgr = LeaderboardManager()

        self.current_deadline: Optional[float] = None
        self.question_winner: Optional[dict] = None
        self.answered_users_this_question: Set[str] = set()

        self._engine_task: Optional[asyncio.Task] = None
        self._queue_task: Optional[asyncio.Task] = None
        self._running = False
        self.dropped_messages = 0

    def start(self) -> None:
        if self._running:
            return
        self._running = True
        self.state = GameState.WAITING_FOR_START
        try:
            loop = asyncio.get_running_loop()
            self._engine_task = loop.create_task(self._run_game_loop())
            self._queue_task = loop.create_task(self._process_queue_loop())
        except RuntimeError:
            pass
        self._notify_snapshot()

    async def stop(self) -> None:
        self._running = False
        self.state = GameState.STOPPED
        if self._engine_task:
            self._engine_task.cancel()
        if self._queue_task:
            self._queue_task.cancel()
        self._notify_snapshot()

    def handle_command(self, cmd: GameCommand) -> None:
        if (
            cmd.command == GameCommandType.START
            and self.state == GameState.WAITING_FOR_START
        ):
            logger.info("Received START command. Beginning trivia game.")
            self.state = GameState.ACTIVE
        elif cmd.command == GameCommandType.STOP:
            asyncio.create_task(self.stop())

    async def _run_game_loop(self) -> None:
        try:
            while self.state == GameState.WAITING_FOR_START and self._running:
                await asyncio.sleep(0.02)

            while self.current_question_index < len(self.questions) and self._running:
                await self._run_question_cycle(self.questions[self.current_question_index])
                self.current_question_index += 1

            if self._running:
                self.state = GameState.FINISHED
                self._notify_snapshot()

        except asyncio.CancelledError:
            pass
        except Exception as exc:
            logger.error(f"Error in game loop: {exc}")
            self.state = GameState.STOPPED
            self._notify_snapshot()

    async def _run_question_cycle(self, question: Question) -> None:
        self.state = GameState.ACTIVE
        self.question_winner = None
        self.answered_users_this_question.clear()
        start_time = time.monotonic()
        self.current_deadline = start_time + self.question_duration_sec
        self._notify_snapshot()

        while (
            time.monotonic() < self.current_deadline
            and self.question_winner is None
            and self._running
        ):
            await asyncio.sleep(0.02)

        self.state = GameState.DRAINING
        self._notify_snapshot()
        await asyncio.sleep(0.1)

        self.state = GameState.RESULT
        self._notify_snapshot()
        await asyncio.sleep(self.result_duration_sec)

        if self.current_question_index < len(self.questions) - 1:
            self.state = GameState.TRANSITION
            self._notify_snapshot()
            await asyncio.sleep(self.transition_duration_sec)

    async def _process_queue_loop(self) -> None:
        try:
            while self._running:
                try:
                    msg: ChatMessage = await asyncio.wait_for(self.chat_queue.get(), timeout=0.05)
                    self._handle_chat_message(msg)
                    self.chat_queue.task_done()
                except asyncio.TimeoutError:
                    continue
        except asyncio.CancelledError:
            pass

    def _handle_chat_message(self, msg: ChatMessage) -> None:
        if self.state != GameState.ACTIVE:
            return

        if self.current_deadline is not None and msg.received_at > (self.current_deadline + 0.5):
            return

        if self.question_winner is not None:
            return

        current_question = self.questions[self.current_question_index]
        
        # Call match_answer with positional/keyword parameters matching app.core.matcher
        answer_type = current_question.answer_type

        is_correct = match_answer(
            user_input=msg.text,
            expected_answers=current_question.answers,
            explicit_type=(
                answer_type.name
                if answer_type is not None
                else None
            ),
        )

        if is_correct:
            player = self.leaderboard_mgr.record_score(
                platform=str(msg.platform),
                user_id=msg.user_id,
                display_name=msg.username,
                timestamp=msg.received_at,
            )
            self.question_winner = {
                "player_key": player.player_key,
                "display_name": player.display_name,
                "platform": player.platform,
            }
            logger.info(
                f"Question {self.current_question_index + 1} WON by {player.display_name}"
            )
            self._notify_snapshot()

    def get_snapshot(self) -> GameSnapshot:
        curr_q = None
        if self.current_question_index < len(self.questions):
            curr_q = self.questions[self.current_question_index].question

        return GameSnapshot(
            state=self.state.value if hasattr(self.state, "value") else str(self.state),
            question_number=self.current_question_index + 1,
            total_questions=len(self.questions),
            question=curr_q,
            deadline=self.current_deadline,
            platforms={},
            queue_size=self.chat_queue.qsize(),
            queue_capacity=getattr(self.chat_queue, "maxsize", 100),
            dropped_messages=self.dropped_messages,
            leaderboard=self.leaderboard_mgr.get_leaderboard(),
        )

    def _notify_snapshot(self) -> None:
        if self.snapshot_callback:
            self.snapshot_callback(self.get_snapshot())